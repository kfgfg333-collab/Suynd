{
  "name": "suynd-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit.test.ts test/no-previews.test.ts test/sources-extra.test.ts test/ytdlp.test.ts test/ytdlp-missing.test.ts",
    "test:live": "tsx --test test/sources.live.test.ts test/full-sources.live.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "music-metadata": "^12.2.3",
    "node-cron": "^4.6.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}
