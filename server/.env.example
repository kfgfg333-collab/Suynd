# Токен бота от @BotFather (выглядит как 123456789:AA...)
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: напишите @userinfobot)
ALLOWED_USER_ID=
# Адрес фронтенда (Vercel), например https://suynd.vercel.app — для CORS и кнопки «Открыть»
WEBAPP_URL=http://localhost:5173
# Порт сервера (Railway подставит свой автоматически)
PORT=3000
# Где хранить базу и обложки. На Railway подключите Volume и укажите /data
DATA_DIR=./data
# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string
# Только для локальной разработки в обычном браузере (без Telegram). В продакшене не включайте!
DEV_AUTH_BYPASS=false
# Необязательно: бесплатный ключ Jamendo (https://devportal.jamendo.com) — ещё один источник полных треков
JAMENDO_CLIENT_ID=
# Сколько места (МБ) отдать под кэш полных аудиофайлов на сервере. 0 — выключить
AUDIO_CACHE_MB=1024

# ── Необязательно: YouTube через yt-dlp ──
# В Docker-образе (server/Dockerfile) yt-dlp уже установлен и путь задан. Локально: pipx install "yt-dlp[default]"
# Без yt-dlp сервер работает, просто без результатов YouTube.
YT_DLP_ENABLED=true
YT_DLP_PATH=yt-dlp
# Таймаут одного запуска yt-dlp, мс (5000–60000, по умолчанию 18000)
YT_DLP_TIMEOUT_MS=18000
# Сколько процессов yt-dlp может работать одновременно (1–8, по умолчанию 2)
YT_DLP_MAX_CONCURRENCY=2
# Необязательно: путь к файлу cookies (формат Netscape) ВАШЕГО аккаунта на диске сервера, например /data/yt-cookies.txt.
# Может помочь, если YouTube требует «подтвердить, что вы не бот». Файл — секрет: держите его только на диске сервера,
# выполните chmod 600, не коммитьте и не вставляйте сюда содержимое. Без этой переменной всё работает.
YT_DLP_COOKIES_FILE=
