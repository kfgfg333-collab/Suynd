# Токен бота от @BotFather (выглядит как 123456789:AA...)
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: напишите @userinfobot)
ALLOWED_USER_ID=
# Адрес фронтенда (Vercel), например https://suynd.vercel.app — для CORS и кнопки «Открыть»
WEBAPP_URL=http://localhost:5173
# Порт сервера (Railway подставит свой автоматически)
PORT=3000
# Где хранить базу и обложки. На Railway подключите Volume и укажите /data
DATA_DIR=./data
# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string
# Только для локальной разработки в обычном браузере (без Telegram). В продакшене не включайте!
DEV_AUTH_BYPASS=false
# Необязательно: бесплатный ключ Jamendo (https://devportal.jamendo.com) — ещё один источник полных треков
JAMENDO_CLIENT_ID=
# Сколько места (МБ) отдать под кэш полных аудиофайлов на сервере. 0 — выключить
AUDIO_CACHE_MB=1024

# ── Необязательно: веб-поиск страниц, где можно послушать трек ──
# Без ключей Suynd ищет только в своих источниках. Можно задать один или оба поисковика.
# Tavily: бесплатно 1000 запросов в месяц, карта не нужна — https://app.tavily.com
TAVILY_API_KEY=
# Яндекс Search API (платный, лучше всех находит русскоязычные страницы): API-ключ сервисного аккаунта
# с ролью search-api.webSearch.user и ID каталога Yandex Cloud
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Потолок запросов к поисковым API в месяц (защита бюджета). 0 — без ограничения
WEB_SEARCH_MONTHLY_LIMIT=900
# Домены, которые никогда не показывать, через запятую (например, example.com,other.org)
WEB_SEARCH_BLOCKED_DOMAINS=
